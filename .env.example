# Modèle local servi par Ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Hugging Face Inference API (ne jamais commiter la vraie clé dans .env)
HUGGINGFACE_API_KEY=hf_votre_cle_ici
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Supabase / pgvector
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_KEY=votre_cle_supabase

# Telegram Bot API
TELEGRAM_BOT_TOKEN=votre_token_botfather
TELEGRAM_WEBHOOK_SECRET=secret_webhook_aleatoire

# Paramètres de l'API
APP_NAME=Willowagent
APP_ENV=development
